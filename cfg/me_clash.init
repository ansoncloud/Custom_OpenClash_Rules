custom_proxy_group=🇺🇸 美国节点`url-test`(美|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|US|us|United States)`https://www.gstatic.com/generate_204`300,,90
custom_proxy_group=🇭🇰 香港节点`url-test`(港|HK|hk|Hong Kong|HongKong|hongkong)`https://www.gstatic.com/generate_204`300,,90
custom_proxy_group=🇯🇵 日本节点`url-test`(日本|川日|东京|大阪|泉日|埼玉|沪日|深日|[^-]日|JP|jp|Japan)`https://www.gstatic.com/generate_204`300,,90
custom_proxy_group=🇼🇸 台湾节点`url-test`(台|新北|彰化|TW|tw|Taiwan)`https://www.gstatic.com/generate_204`300,,90
custom_proxy_group=🇸🇬 新加坡节点`url-test`(新加坡|坡|狮城|SG|sg|Singapore)`https://www.gstatic.com/generate_204`300,,90
custom_proxy_group=🇰🇷 韩国节点`url-test`(KR|kr|Korea|KOR|首尔|韩|韓)`https://www.gstatic.com/generate_204`300,,90
;设置分组标志位

enable_rule_generator=true
overwrite_original_rules=true
